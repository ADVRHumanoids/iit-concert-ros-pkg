<?xml version="1.0" encoding="utf-8"?>
<robot name="ModularBot">
  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>
  <material name="green">
    <color rgba="0 1 0 1"/>
  </material>
  <material name="yellow">
    <color rgba="1 1 0 1"/>
  </material>
  <material name="tree_green">
    <color rgba="0.13 0.54 0.13 1"/>
  </material>
  
  
  <link name="base_link">
    <visual>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1.0e-06" ixy="0.0" ixz="0.0" iyy="1.0e-06" iyz="0.0" izz="1.0e-06"/>
    </inertial>
  </link>
  
  <link name="mobile_base">
    <visual>
      <origin rpy="0.0 -0.0 0.0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file:///workspace/iit-concert-ros-pkg/concert_urdf/meshes/concert/concert_central_body.stl" scale="0.001 0.001 0.001"/>
