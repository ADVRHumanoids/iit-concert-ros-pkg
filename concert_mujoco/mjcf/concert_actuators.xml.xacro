<?xml version="1.0"?>
<mujoco xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- Actuator names MUST equal joint names: the xbot2 bridge looks them up by joint -->
    <actuator>

        <!-- steering -->
        <position class="concert_steering" name="J1_A" joint="J1_A" />
        <position class="concert_steering" name="J1_B" joint="J1_B" />
        <position class="concert_steering" name="J1_C" joint="J1_C" />
        <position class="concert_steering" name="J1_D" joint="J1_D" />

        <!-- wheels, velocity-controlled -->
        <intvelocity class="concert_wheel" name="J_wheel_A" joint="J_wheel_A" />
        <intvelocity class="concert_wheel" name="J_wheel_B" joint="J_wheel_B" />
        <intvelocity class="concert_wheel" name="J_wheel_C" joint="J_wheel_C" />
        <intvelocity class="concert_wheel" name="J_wheel_D" joint="J_wheel_D" />

        <!-- arm -->
        <position class="concert_arm" name="J1_E" joint="J1_E" />
        <position class="concert_arm" name="J2_E" joint="J2_E" />
        <position class="concert_arm" name="J3_E" joint="J3_E" />
        <position class="concert_arm" name="J4_E" joint="J4_E" />
        <position class="concert_arm" name="J5_E" joint="J5_E" />
        <position class="concert_arm" name="J6_E" joint="J6_E" />

    </actuator>

</mujoco>
