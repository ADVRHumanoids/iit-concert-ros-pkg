<?xml version="1.0"?>
<mujoco xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- base_link height at spawn [m] -->
    <xacro:arg name="spawn_z" default="1.0" />
    <xacro:property name="SPAWN_Z" value="$(arg spawn_z)" />

    <xacro:include filename="$(find concert_mujoco)/mjcf/concert_actuators.xml.xacro" />
    <xacro:include filename="$(find concert_mujoco)/mjcf/concert_options.xml.xacro" />

</mujoco>
