# concert-specific configuration for docker builds (ROS1)

export ROBOT_NAME=concert
export USER_NAME=user
export USER_ID=1000
export KERNEL_VER=5

# Repository and recipes configuration
export RECIPES_TAG=concert-ros1
export RECIPES_REPO=git@github.com:advrhumanoids/multidof_recipes.git

# Concert-specific packages to install in the container
export ROBOT_PACKAGES="iit-concert-ros-pkg concert_config estimation_utils imu_simulator"
export ADDITIONAL_PACKAGES=""

# Docker image naming - matches docker-base naming convention
export DISTRO=focal
export ROS_VERSION=ros1
export BASE_IMAGE_NAME=concert-focal-ros1

# Version and registry
export TAGNAME=latest
export DOCKER_REGISTRY=hhcmhub

# This configuration is used by the docker-base build system
# The build script will create images like:
#   hhcmhub/concert-focal-ros1-base:latest
#   hhcmhub/concert-focal-ros1-xeno-v5:latest
#   hhcmhub/concert-focal-ros1-locomotion:latest
